{
  "name": "agent-orch",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.17.1 <23",
    "pnpm": "10.33.0"
  },
  "workspaces": [
    "packages/*",
    "app/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "pnpm --filter @agent-orch/server dev",
    "dev:web": "pnpm --filter @agent-orch/web dev",
    "build": "pnpm --filter @agent-orch/shared build && pnpm --filter @agent-orch/server build && pnpm --filter @agent-orch/web build",
    "test": "pnpm --filter @agent-orch/server test && pnpm --filter @agent-orch/web test",
    "audit:setup-commands": "pnpm --filter @agent-orch/server audit:setup-commands"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  }
}
